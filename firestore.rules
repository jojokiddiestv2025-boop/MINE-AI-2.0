rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() { return request.auth != null; }
    function isOwner(schoolId) { return isSignedIn() && get(/databases/$(database)/documents/schools/$(schoolId)).data.adminId == request.auth.uid; }

    match /schools/{schoolId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.adminId == request.auth.uid;
      allow update: if isOwner(schoolId);
      
      match /users/{userId} {
        allow read: if isSignedIn();
        allow write: if isOwner(schoolId);
      }
      
      match /quizzes/{quizId} {
        allow read: if isSignedIn();
        allow write: if isOwner(schoolId);
      }
    }
  }
}
